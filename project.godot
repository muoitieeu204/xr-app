; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodotXR"
run/main_scene="uid://dacrvo5efu5py"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://dpr132vrqgah0"
driver/enable_input=true
driver/mix_rate=16000
input/transcribe/use_gpu=true

[autoload]

XRToolsUserSettings="*res://addons/godot-xr-tools/user_settings/user_settings.gd"
XRToolsRumbleManager="*res://addons/godot-xr-tools/rumble/rumble_manager.gd"
SessionData="*res://scripts/CoreManager/SessionData.gd"
SessionUploader="*res://scripts/CoreManager/SessionUploader.cs"
AzureSpeechManager="*res://scripts/CoreManager/AzureSpeechManager.cs"
GameManager="*res://scripts/CoreManager/GameManager.gd"
PlayerData="*res://Prefabs/PlayerPrefabs/PlayerData.gd"
RefreshTokenApi="*res://scripts/API/RefreshTokenApi.gd"
ResultApi="*res://scripts/API/result-api.gd"
ReplayManager="*res://Prefabs/PlayerPrefabs/ReplayManager.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="GodotXR _Attempt_1"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg", "res://addons/meshcombiner/plugin.cfg")

[global_group]

interactable="Interactable Object"
VoiceLines=""
LevelController=""
TaskUI=""
MenuUI="Main Menu popup"
MenuViewport="Vr Player Main Menu"

[godot_xr_tools]

player/standard_height=1.7

